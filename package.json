{
  "name": "linux-command-centre",
  "version": "0.1.0",
  "description": "Linux hardware management dashboard",
  "license": "MIT",
  "desktopName": "linux-command-centre.desktop",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "check": "svelte-check --tsconfig ./tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "preview": "electron-vite preview",
    "package": "npm run build && electron-builder"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.20",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "postcss": "^8.4.49",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^3.4.14",
    "tslib": "^2.8.1",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@tanstack/svelte-query": "^5.59.16",
    "bits-ui": "^1.0.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "lucide-svelte": "^0.460.0",
    "tailwind-merge": "^2.5.4",
    "uplot": "^1.6.31",
    "ws": "^8.18.0",
    "zod": "^4.4.3"
  },
  "build": {
    "appId": "com.electron.linux-command-centre",
    "productName": "Linux Command Centre",
    "copyright": "Copyright 2024",
    "asar": true,
    "asarUnpack": [
      "**\\*.{node,dll,exe}",
      "**\\preload.js"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out"
    ],
    "extraResources": [
      {
        "from": "helper/lcc-helper.js",
        "to": "helper/lcc-helper.js"
      },
      {
        "from": "helper/lcc-helper",
        "to": "helper/lcc-helper"
      },
      {
        "from": "helper/io.lcc.helper.policy",
        "to": "helper/io.lcc.helper.policy"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "linux": {
      "category": "System;Settings;",
      "maintainer": "linux-command-centre",
      "syncDesktopName": true,
      "vendor": "Linux Command Centre",
      "synopsis": "Centralised Linux system management",
      "description": "A desktop dashboard for managing Linux systems: system info, network, VPN, Wi-Fi, Bluetooth, firewall, DNS, hardware, storage, services, logs, and more.",
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "deb": {
      "afterInstall": "helper/after-install.sh",
      "afterRemove": "helper/after-remove.sh"
    },
    "rpm": {
      "afterInstall": "helper/after-install.sh",
      "afterRemove": "helper/after-remove.sh"
    },
    "mac": {
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "nsis": {
      "allowToChangeInstallationDirectory": true,
      "oneClick": false
    }
  }
}
